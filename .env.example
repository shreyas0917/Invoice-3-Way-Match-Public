# Local settings for development (copy to .env - git-ignored - and uncomment what you need).
# No secrets belong here or in Git: on SAP BTP, XSUAA/HANA credentials come from service
# bindings and S/4HANA credentials from destinations (see README "Deploying to SAP BTP").

# Use the S/4 adapter with CAP's local mocks of the SAP APIs instead of the facade mock
# (same as `npm run watch:s4`).
# CDS_ENV=s4-adapter

# Simulate S/4 failures with the facade mock: none | timeout | error
# cds_requires_ExternalPurchaseOrderService_mock_failureMode=timeout
# cds_requires_ExternalPurchaseOrderService_timeout=1000

# Point the adapter at real S/4HANA APIs from a local machine (needs CDS_ENV=s4-adapter).
# Service names contain underscores, so use CDS_CONFIG (JSON). Put real URLs and credentials only
# in your own .env, never in Git; prefer `cds bind` to a BTP destination.
# CDS_CONFIG={"requires":{"API_PURCHASEORDER_2":{"credentials":{"url":"<service root>"}},"API_MATERIAL_DOCUMENT":{"credentials":{"url":"<service root>"}},"API_BUSINESS_PARTNER":{"credentials":{"url":"<service root>"}}}}
