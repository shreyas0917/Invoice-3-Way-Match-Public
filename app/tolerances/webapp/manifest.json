{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ap.tolerances",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ap.tolerances.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ConfigurationList",
          "target": "ConfigurationList"
        },
        {
          "pattern": "ToleranceRules({key}):?query:",
          "name": "ToleranceRulesObjectPage",
          "target": "ToleranceRulesObjectPage"
        },
        {
          "pattern": "ApprovalPolicies({key}):?query:",
          "name": "ApprovalPoliciesObjectPage",
          "target": "ApprovalPoliciesObjectPage"
        }
      ],
      "targets": {
        "ConfigurationList": {
          "type": "Component",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ToleranceRules",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ToleranceRules": {
                  "detail": {
                    "route": "ToleranceRulesObjectPage"
                  }
                },
                "ApprovalPolicies": {
                  "detail": {
                    "route": "ApprovalPoliciesObjectPage"
                  }
                }
              },
              "views": {
                "showCounts": true,
                "paths": [
                  {
                    "key": "rules",
                    "entitySet": "ToleranceRules",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Rules"
                  },
                  {
                    "key": "policies",
                    "entitySet": "ApprovalPolicies",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Policies"
                  }
                ]
              }
            }
          },
          "id": "ConfigurationList"
        },
        "ToleranceRulesObjectPage": {
          "type": "Component",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ToleranceRules",
              "editableHeaderContent": false
            }
          },
          "id": "ToleranceRulesObjectPage"
        },
        "ApprovalPoliciesObjectPage": {
          "type": "Component",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ApprovalPolicies",
              "editableHeaderContent": false
            }
          },
          "id": "ApprovalPoliciesObjectPage"
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
