{
  "name": "invoice-workbench",
  "version": "0.1.0",
  "description": "Invoice 3-Way Match & Exception Workbench - SAP CAP Node.js portfolio project",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest --runInBand",
    "watch:s4": "node scripts/generate-s4-fixtures.js && cds watch --profile s4-adapter",
    "s4:fixtures": "node scripts/generate-s4-fixtures.js"
  },
  "dependencies": {
    "@cap-js/change-tracking": "^2.2.3",
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^10.2.2",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0",
    "jest": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "cds": {
    "invoiceWorkbench": {
      "defaults": {
        "companyCode": "1010",
        "currency": "INR"
      }
    },
    "requires": {
      "ExternalPurchaseOrderService": {
        "model": "srv/external/purchase-order-facade",
        "timeout": 5000
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "clerk1": {
              "roles": [
                "APClerk"
              ]
            },
            "clerk2": {
              "roles": [
                "APClerk"
              ]
            },
            "buyer1": {
              "roles": [
                "Buyer"
              ],
              "attr": {
                "purchasingGroup": "001"
              }
            },
            "buyer2": {
              "roles": [
                "Buyer"
              ],
              "attr": {
                "purchasingGroup": "002"
              }
            },
            "manager1": {
              "roles": [
                "APManager"
              ]
            },
            "nobody": {
              "roles": []
            },
            "alice": false,
            "bob": false,
            "carol": false,
            "dave": false,
            "erin": false,
            "fred": false,
            "me": false,
            "yves": false,
            "*": false
          }
        },
        "s4mock": {
          "model": "mock-data/s4mock"
        },
        "ExternalPurchaseOrderService": {
          "impl": "srv/external/mock-po-service.js",
          "mock": {
            "failureMode": "none"
          }
        },
        "db": {
          "data": [
            "db/data"
          ]
        }
      },
      "[test]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "clerk1": {
              "roles": [
                "APClerk"
              ]
            },
            "clerk2": {
              "roles": [
                "APClerk"
              ]
            },
            "buyer1": {
              "roles": [
                "Buyer"
              ],
              "attr": {
                "purchasingGroup": "001"
              }
            },
            "buyer2": {
              "roles": [
                "Buyer"
              ],
              "attr": {
                "purchasingGroup": "002"
              }
            },
            "manager1": {
              "roles": [
                "APManager"
              ]
            },
            "nobody": {
              "roles": []
            },
            "alice": false,
            "bob": false,
            "carol": false,
            "dave": false,
            "erin": false,
            "fred": false,
            "me": false,
            "yves": false,
            "*": false
          }
        },
        "s4mock": {
          "model": "mock-data/s4mock"
        },
        "ExternalPurchaseOrderService": {
          "impl": "srv/external/mock-po-service.js",
          "mock": {
            "failureMode": "none"
          }
        },
        "db": {
          "data": [
            "db/data",
            "test/data"
          ]
        }
      },
      "[s4-adapter!]": {
        "ExternalPurchaseOrderService": {
          "impl": "srv/external/s4-adapter.js"
        },
        "API_PURCHASEORDER_2": {
          "kind": "odata",
          "model": "srv/external/s4-apis"
        },
        "API_MATERIAL_DOCUMENT": {
          "kind": "odata-v2",
          "model": "srv/external/s4-apis"
        },
        "API_BUSINESS_PARTNER": {
          "kind": "odata-v2",
          "model": "srv/external/s4-apis"
        },
        "s4api": {
          "model": "mock-data/s4api"
        }
      },
      "[production]": {
        "ExternalPurchaseOrderService": {
          "impl": "srv/external/s4-adapter.js"
        },
        "API_PURCHASEORDER_2": {
          "kind": "odata",
          "model": "srv/external/s4-apis",
          "credentials": {
            "destination": "S4HANA_PURCHASEORDER_2",
            "requestTimeout": 5000
          }
        },
        "API_MATERIAL_DOCUMENT": {
          "kind": "odata-v2",
          "model": "srv/external/s4-apis",
          "credentials": {
            "destination": "S4HANA_MATERIAL_DOCUMENT",
            "requestTimeout": 5000
          }
        },
        "API_BUSINESS_PARTNER": {
          "kind": "odata-v2",
          "model": "srv/external/s4-apis",
          "credentials": {
            "destination": "S4HANA_BUSINESS_PARTNER",
            "requestTimeout": 5000
          }
        },
        "auth": "xsuaa",
        "destinations": true
      }
    },
    "log": {
      "[production]": {
        "levels": {
          "remote": "error"
        }
      }
    }
  }
}
