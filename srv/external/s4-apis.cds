/**
 * The imported official SAP API models (generated by `cds import` into ./s4 - not edited) plus
 * what this project adds to them: they are never served over HTTP.
 *
 * Only the S/4 adapter (srv/external/s4-adapter.js) uses these services, in-process. Remote,
 * CAP calls the real APIs; locally (cds watch / --with-mocks) CAP mocks them - and without
 * @protocol: 'none' those mocks would be public OData endpoints that let any user (clerk,
 * buyer) read all POs and suppliers, past the purchasing-group restrictions.
 *
 * The three models in ./s4 are NOT part of this repository: they are generated from SAP's API
 * specifications, which you obtain with your own SAP account - see docs/sap-api-setup.md.
 * Without them, only the default (mock) mode works; the s4-adapter and production profiles
 * fail with "Can't find local module './s4/...'".
 */
using { API_PURCHASEORDER_2 } from './s4/API_PURCHASEORDER_2';
using { API_MATERIAL_DOCUMENT } from './s4/API_MATERIAL_DOCUMENT';
using { API_BUSINESS_PARTNER } from './s4/API_BUSINESS_PARTNER';

annotate API_PURCHASEORDER_2 with @protocol: 'none';
annotate API_MATERIAL_DOCUMENT with @protocol: 'none';
annotate API_BUSINESS_PARTNER with @protocol: 'none';
